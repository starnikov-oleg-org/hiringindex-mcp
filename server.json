{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.starnikovoleg/hiringindex-mcp",
  "description": "Search live job postings, aggregate any market slice, and see how long each listing has been open.",
  "repository": {
    "url": "https://github.com/starnikov-oleg-org/hiringindex-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "hiringindex-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HIRINGINDEX_API_KEY",
          "description": "API key. Also accepts RAPIDAPI_KEY.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "HIRINGINDEX_API_BASE",
          "description": "Call the backend directly instead of the marketplace.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
